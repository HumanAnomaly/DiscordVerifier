# Copy this file to .env and fill in the values.
# Never commit .env to git.

# Bot token from https://discord.com/developers/applications → Bot → Token
DISCORD_TOKEN=

# Application (client) ID from General Information
CLIENT_ID=

# Your Discord server (guild) ID: Developer Mode on, right-click server, Copy Server ID
GUILD_ID=

# Role to grant after verification: right-click role in Server Settings, Copy ID
VERIFIED_ROLE_ID=

# Optional: role given on join and removed on verify. Leave empty to disable.
# Gate channels by denying this role View Channel where needed.
UNVERIFIED_ROLE_ID=
